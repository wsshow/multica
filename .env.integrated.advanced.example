# Optional raw KEY=value entries to add to .env.integrated.
# Existing application variables remain supported; see .env.example.
S3_USE_PATH_STYLE=
ATTACHMENT_DOWNLOAD_MODE=proxy
REDIS_CLUSTER_MODE=false
CHANNEL_WS_LEASE_BACKEND=

# Only the actual outer reverse proxy's addresses or CIDRs, comma-separated.
MULTICA_GATEWAY_TRUSTED_PROXIES=

# Alternatives to SMTP; always supply a sender when selecting Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ALLOW_SIGNUP=true
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Optional integrations need their own persistent keys and operator URLs.
# WeChat QR connections: generate once with openssl rand -base64 32.
MULTICA_WEIXIN_SECRET_KEY=
MULTICA_PLUGIN_SECRET_KEY=
MULTICA_PLUGIN_SURFACE_ORIGIN=
MULTICA_PLUGIN_API_URL=
MULTICA_PLUGIN_DIR=
MULTICA_CLI_INSTALL_URL=
MULTICA_CLI_INSTALL_WINDOWS_URL=
DOCS_URL=

# Connection retry budget, not a migration DDL timeout.
MULTICA_DATABASE_STARTUP_TIMEOUT=3m
MULTICA_CONTAINER_SHUTDOWN_TIMEOUT=60
