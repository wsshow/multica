# Raw KEY=value data: do not add quotes or shell substitutions.
# No database, object-storage, or production mail service is bundled.
MULTICA_PUBLIC_URL=
DATABASE_URL=
JWT_SECRET=

S3_BUCKET=
S3_REGION=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional for a single application instance. Redis-backed auth limits are
# disabled when empty.
REDIS_URL=

# Configure your mail relay and sender, or use the advanced OAuth/Resend options.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=starttls

MULTICA_VCS_INTEGRATION_ENABLED=true
MULTICA_VCS_SECRET_KEY=
