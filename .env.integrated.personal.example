# Optional raw KEY=value overrides. The local installation needs no env file.
# Only set a public URL for access through an external origin.
# MULTICA_PUBLIC_URL=https://tasks.example.com

# Leave empty to use the included PostgreSQL service.
# DATABASE_URL=postgresql://user:password@database.example.com/multica?sslmode=require

# Redis is off by default. Set MULTICA_MANAGED_REDIS=true for the bundled service.
# MULTICA_MANAGED_REDIS=true
# Set REDIS_URL to use an external service instead.
# REDIS_URL=rediss://user:password@redis.example.com:6379/0

# Leave empty to store uploads on the local volume.
# S3_BUCKET=
# S3_REGION=
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Disabled until enabled here. An installation key is generated and retained.
# MULTICA_VCS_INTEGRATION_ENABLED=true
